#!/bin/sh
# Refuse a commit message that still holds git's "# Conflicts:" block, which a merge
# committed without cleanup (git commit --no-edit, -F, --cleanup=verbatim) keeps.
# Enable once per clone: git config core.hooksPath .githooks
if grep -q '^# Conflicts:' "$1"; then
    echo "commit-msg: the message still holds git's '# Conflicts:' block; delete that block and commit again." >&2
    exit 1
fi
