#!/bin/sh
# Delete git's "# Conflicts:" block (that line and the indented "#<tab><path>" lines
# after it) from the commit message. A merge committed without the editor
# (git commit --no-edit, -F, --cleanup=verbatim) would otherwise keep it; in the
# editor flow git strips comment lines only after this hook, so the hook must not refuse.
# Enable once per clone: git config core.hooksPath .githooks
grep -q '^# Conflicts:' "$1" || exit 0
tmp="$1.conflicts.$$"
awk '
    /^# Conflicts:/ { skipping = 1; next }
    skipping && /^#\t/ { next }
    { skipping = 0; print }
' "$1" > "$tmp" && mv "$tmp" "$1"
